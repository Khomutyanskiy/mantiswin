{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Страница Mantis (её отдаёт встроенный агент на localhost) может вызывать команды приложения",
  "windows": ["main"],
  "remote": {
    "urls": ["http://localhost:*", "http://127.0.0.1:*"]
  },
  "permissions": [
    "core:default",
    "allow-app-info",
    "allow-keep-awake",
    "allow-set-autostart",
    "allow-pilot-state",
    "allow-quit-app",
    "allow-notify",
    "allow-tray-status"
  ]
}
