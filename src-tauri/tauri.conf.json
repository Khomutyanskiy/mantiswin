{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mantis",
  "version": "0.1.0",
  "identifier": "ru.rsmit.mantis",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Mantis — аналитика витрины",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "backgroundColor": "#0a1230",
        "backgroundThrottling": "disabled",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows --disable-background-media-suspend --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "РСМ АйТи",
    "copyright": "© РСМ АйТи",
    "category": "Business",
    "shortDescription": "Подсчёт посетителей витрины",
    "longDescription": "Mantis считает, сколько людей прошло мимо витрины, притормозило, посмотрело и зашло в магазин — с одной или нескольких камер. Видео обрабатывается на этом компьютере и никуда не отправляется.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/mantis-agent"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian"],
        "displayLanguageSelector": false
      }
    }
  }
}
